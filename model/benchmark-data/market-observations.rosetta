override namespace impl.cdm.market
version "1.0.0"
import cdm.base.math.DatedValue
import cdm.base.datetime.PeriodEnum
import cdm.base.staticdata.asset.rates.FloatingRateIndexEnum
import cdm.observable.asset.InterestRateIndex
import cdm.observable.asset.FloatingRateIndex

func ReadMarketObservations:
    inputs:
        index InterestRateIndex (1..1)
        dates date (1..*)
    output:
        observations DatedValue (0..*)
    alias floating: index as FloatingRateIndex
    alias code: floating -> floatingRateIndex
    alias tenor: floating -> indexTenor
    condition BenchmarkIndexSupported:
        floating exists and (code = FloatingRateIndexEnum -> EUR_EuroSTR or code = FloatingRateIndexEnum -> EUR_EuroSTR_Compounded_Index or code = FloatingRateIndexEnum -> USD_SOFR or code = FloatingRateIndexEnum -> USD_SOFR_Compounded_Index or code = FloatingRateIndexEnum -> GBP_SONIA or code = FloatingRateIndexEnum -> GBP_SONIA_Compounded_Index)
    condition BenchmarkTenorSupported:
        tenor is absent or (tenor -> period = PeriodEnum -> D and tenor -> periodMultiplier = 1)
    set observations:
        (if code = FloatingRateIndexEnum -> EUR_EuroSTR
        then [
            DatedValue { date: date { year: 2026, month: 11, day: 2 }, value: 0.02441 },
            DatedValue { date: date { year: 2026, month: 11, day: 3 }, value: 0.02445 },
            DatedValue { date: date { year: 2026, month: 11, day: 4 }, value: 0.02442 },
            DatedValue { date: date { year: 2026, month: 11, day: 5 }, value: 0.02442 },
            DatedValue { date: date { year: 2026, month: 11, day: 6 }, value: 0.02443 },
            DatedValue { date: date { year: 2026, month: 11, day: 9 }, value: 0.02442 }
        ]
        else if code = FloatingRateIndexEnum -> EUR_EuroSTR_Compounded_Index
        then [
            DatedValue { date: date { year: 2026, month: 11, day: 2 }, value: 110.1368395 },
            DatedValue { date: date { year: 2026, month: 11, day: 3 }, value: 110.14430739 },
            DatedValue { date: date { year: 2026, month: 11, day: 4 }, value: 110.15178803 },
            DatedValue { date: date { year: 2026, month: 11, day: 5 }, value: 110.15925999 },
            DatedValue { date: date { year: 2026, month: 11, day: 6 }, value: 110.16673246 },
            DatedValue { date: date { year: 2026, month: 11, day: 9 }, value: 110.18916057 }
        ]
        else if code = FloatingRateIndexEnum -> USD_SOFR
        then [
            DatedValue { date: date { year: 2026, month: 11, day: 2 }, value: 0.0395 },
            DatedValue { date: date { year: 2026, month: 11, day: 3 }, value: 0.0397 },
            DatedValue { date: date { year: 2026, month: 11, day: 4 }, value: 0.0394 },
            DatedValue { date: date { year: 2026, month: 11, day: 5 }, value: 0.0392 },
            DatedValue { date: date { year: 2026, month: 11, day: 6 }, value: 0.0389 },
            DatedValue { date: date { year: 2026, month: 11, day: 9 }, value: 0.0388 }
        ]
        else if code = FloatingRateIndexEnum -> USD_SOFR_Compounded_Index
        then [
            DatedValue { date: date { year: 2026, month: 11, day: 2 }, value: 1.26536948 },
            DatedValue { date: date { year: 2026, month: 11, day: 3 }, value: 1.26550832 },
            DatedValue { date: date { year: 2026, month: 11, day: 4 }, value: 1.26564788 },
            DatedValue { date: date { year: 2026, month: 11, day: 5 }, value: 1.26578639 },
            DatedValue { date: date { year: 2026, month: 11, day: 6 }, value: 1.26592422 },
            DatedValue { date: date { year: 2026, month: 11, day: 9 }, value: 1.26633459 }
        ]
        else if code = FloatingRateIndexEnum -> GBP_SONIA
        then [
            DatedValue { date: date { year: 2026, month: 11, day: 2 }, value: 0.037352 },
            DatedValue { date: date { year: 2026, month: 11, day: 3 }, value: 0.037342 },
            DatedValue { date: date { year: 2026, month: 11, day: 4 }, value: 0.037335 },
            DatedValue { date: date { year: 2026, month: 11, day: 5 }, value: 0.039824 },
            DatedValue { date: date { year: 2026, month: 11, day: 6 }, value: 0.039852 },
            DatedValue { date: date { year: 2026, month: 11, day: 9 }, value: 0.039842 }
        ]
        else if code = FloatingRateIndexEnum -> GBP_SONIA_Compounded_Index
        then [
            DatedValue { date: date { year: 2026, month: 11, day: 2 }, value: 121.87457567 },
            DatedValue { date: date { year: 2026, month: 11, day: 3 }, value: 121.88704761 },
            DatedValue { date: date { year: 2026, month: 11, day: 4 }, value: 121.89951749 },
            DatedValue { date: date { year: 2026, month: 11, day: 5 }, value: 121.91198631 },
            DatedValue { date: date { year: 2026, month: 11, day: 6 }, value: 121.92528774 },
            DatedValue { date: date { year: 2026, month: 11, day: 9 }, value: 121.96522445 }
        ]
        else empty) filter [dates contains (item -> date)]
